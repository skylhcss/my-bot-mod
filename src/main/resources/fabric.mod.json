{
	"schemaVersion": 1,
	"id": "my-bot-mod",
	"version": "${version}",
	"name": "我的机器人",
	"description": "一个类似 Carpet Mod 的假人（机器人玩家）模组，提供假人召唤和控制功能",
	"authors": [
		"Skyline_hcss"
	],
	"contact": {
		"homepage": "https://github.com/skylhcss/my-bot-mod",
		"sources": "https://github.com/skylhcss/my-bot-mod",
		"issues": "https://github.com/skylhcss/my-bot-mod/issues",
		"email": "Skyline.hcss@gmail.com"
	},
	"license": "MIT",
	"icon": "assets/my-bot-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"name.modid.MyBotMod"
		],
		"client": [
			"name.modid.client.MyBotModClient"
		],
		"fabric-datagen": [
			"name.modid.client.MyBotModDataGenerator"
		]
	},
	"mixins": [
		"my-bot-mod.mixins.json",
		{
			"config": "my-bot-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${mc_dep}",
		"java": "${java_dep}",
		"fabric-api": "*"
	}
}